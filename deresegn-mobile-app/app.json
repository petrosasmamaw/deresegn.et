{
  "expo": {
    "name": "Tamagn Check",
    "slug": "deresegn-mobile-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "deresegn",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.tamagncheck.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "online.tamagncheck.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F4EEDC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4EEDC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tamagn Check to access receipt photos for verification.",
          "cameraPermission": "Allow Tamagn Check to photograph receipts for verification."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec8ccc17-7c68-4eb6-a87c-7ca759d109f4"
      }
    }
  }
}
