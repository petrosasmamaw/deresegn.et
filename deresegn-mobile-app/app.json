{
  "expo": {
    "name": "Tamagn Check",
    "slug": "deresegn-mobile-app",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2c77cbd0-e138-4741-b7ea-aa7de802dc9e"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "deresegn",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.tamagncheck.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "online.tamagncheck.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F4EEDC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4EEDC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tamagn Check to access receipt photos for verification.",
          "cameraPermission": "Allow Tamagn Check to photograph receipts for verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2c77cbd0-e138-4741-b7ea-aa7de802dc9e"
      }
    },
    "owner": "petrosasmamaw2"
  }
}
