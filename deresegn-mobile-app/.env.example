# Copy to .env and edit. Restart Expo after every change.
# API hosts live only here — not in source code.

# --- LOCAL DEV (default) ---
# Android emulator → host PC localhost:5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:5000/api/auth
EXPO_PUBLIC_WEB_URL=https://tamagncheck.online

# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_AUTH_URL=http://localhost:5000/api/auth

# Physical phone (same Wi‑Fi):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
# EXPO_PUBLIC_AUTH_URL=http://192.168.x.x:5000/api/auth

# --- PRODUCTION (installable app) ---
# EXPO_PUBLIC_API_URL=https://deresegn-et.onrender.com/api
# EXPO_PUBLIC_AUTH_URL=https://deresegn-et.onrender.com/api/auth
# EXPO_PUBLIC_WEB_URL=https://tamagncheck.online
