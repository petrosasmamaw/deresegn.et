# Expo public env (loaded by Metro / Expo)
# Android emulator → host machine API:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:5000/api/auth

# Public website origin for certificate share links (/verify/:token)
EXPO_PUBLIC_WEB_URL=https://tamagncheck.online

# iOS simulator (uncomment):
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_AUTH_URL=http://localhost:5000/api/auth

# Physical device / production — use your machine LAN IP or prod API:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
# EXPO_PUBLIC_AUTH_URL=http://192.168.x.x:5000/api/auth
# EXPO_PUBLIC_API_URL=https://api.tamagncheck.online/api
# EXPO_PUBLIC_AUTH_URL=https://api.tamagncheck.online/api/auth
# EXPO_PUBLIC_WEB_URL=https://tamagncheck.online
