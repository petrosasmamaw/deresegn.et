{
  "name": "deresegn-mobile-app",
  "version": "1.0.1",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.19.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.15",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-redux": "^9.3.0"
  },
  "scripts": {
    "prestart": "node scripts/free-port.js 8081",
    "start": "expo start --port 8081",
    "android": "node scripts/free-port.js 8081 && expo start --port 8081 --android",
    "ios": "node scripts/free-port.js 8081 && expo start --port 8081 --ios",
    "web": "node scripts/free-port.js 8081 && expo start --port 8081 --web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export": "expo export --platform all --output-dir dist",
    "ota:preview": "eas update --channel preview",
    "ota:production": "eas update --channel production",
    "test": "node --test"
  },
  "private": true
}
