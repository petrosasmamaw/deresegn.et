{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tamagntech.pro.et/api",
        "EXPO_PUBLIC_AUTH_URL": "https://tamagntech.pro.et/api/auth",
        "EXPO_PUBLIC_WEB_URL": "https://tamagncheck.online"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tamagntech.pro.et/api",
        "EXPO_PUBLIC_AUTH_URL": "https://tamagntech.pro.et/api/auth",
        "EXPO_PUBLIC_WEB_URL": "https://tamagncheck.online"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}
