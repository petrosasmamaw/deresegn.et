# Shared env for client + server (copy to .env)

# --- Server (copy from your existing server/.env) ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=
BETTER_AUTH_SECRET=
# Local: browser talks to Vite, which proxies /api → :5000
BETTER_AUTH_URL=http://localhost:5173/api/auth
GEMINI_API_KEY=
# ... other server keys (Cloudinary, Brevo, Petros, etc.) unchanged ...

# --- Frontend (same-origin) ---
VITE_API_URL=/api
VITE_AUTH_URL=/api/auth

# Vercel production:
#   CLIENT_URL=https://your-domain.com
#   BETTER_AUTH_URL=https://your-domain.com/api/auth
#   VITE_API_URL=/api
#   VITE_AUTH_URL=/api/auth
#   + all server secrets in Vercel → Environment Variables
