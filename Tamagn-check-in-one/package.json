{
  "name": "tamagn-check-in-one",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tamagn Check — Vite client + Express API in one Vercel deploy",
  "scripts": {
    "dev": "node scripts/devBoth.mjs",
    "dev:client": "vite",
    "dev:server": "nodemon --config nodemon.json",
    "build": "vite build",
    "start": "node server/src/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test server/tests/**/*.test.js",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:studio": "npm --prefix server run db:studio",
    "seed:users": "node server/scripts/seedUsers.mjs",
    "train:dashen": "node server/scripts/trainDashen.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/browser": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "@tailwindcss/vite": "^4.3.0",
    "@zxing/library": "^0.21.3",
    "axios": "^1.16.1",
    "better-auth": "1.2.8",
    "cloudinary": "^2.6.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.17.0",
    "multer": "^1.4.5-lts.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.16.0",
    "redis": "^6.2.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^2.0.22",
    "postcss": "^8.5.15",
    "vite": "^8.0.12"
  }
}
