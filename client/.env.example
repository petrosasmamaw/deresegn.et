# Local development only
VITE_API_URL=http://localhost:5000/api
VITE_AUTH_URL=http://localhost:5000/api/auth

# Vercel production — leave VITE_* UNSET (recommended).
# The app auto-uses /api on your Vercel domain (proxied to Render).
# Do NOT set VITE_API_URL to localhost or Render on Vercel builds.
