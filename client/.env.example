# Frontend API base URL (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:5000/api

# Better Auth — must point at your deployed API in production
# VITE_AUTH_URL=https://your-api-host.com/api/auth
VITE_AUTH_URL=http://localhost:5000/api/auth

# Vercel production — use same-origin /api proxy (see client/vercel.json):
# VITE_API_URL=/api
# VITE_AUTH_URL=/api/auth
#
# Render env when using Vercel proxy:
# BETTER_AUTH_URL=https://check-deresegn-et.vercel.app/api/auth
# CLIENT_URL=https://check-deresegn-et.vercel.app
