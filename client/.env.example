# Local development — copy to client/.env
VITE_API_URL=http://localhost:8787/api
VITE_AUTH_URL=http://localhost:8787/api/auth

# Vercel production (recommended — same-origin via vercel.json rewrite to Workers):
# Leave these unset OR set:
# VITE_API_URL=/api
# VITE_AUTH_URL=https://tamagncheck.online/api/auth
#
# Alternative (direct Workers — needs CORS + SameSite=None cookies):
# VITE_API_URL=https://deresegn-api.asmamawpetros.workers.dev/api
# VITE_AUTH_URL=https://deresegn-api.asmamawpetros.workers.dev/api/auth

# Optional — Sentry
# VITE_SENTRY_DSN=
