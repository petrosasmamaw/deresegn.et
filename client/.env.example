# Local development — copy to client/.env
VITE_API_URL=http://localhost:5000/api
VITE_AUTH_URL=http://localhost:5000/api/auth

# Vercel production (same keys — set in Vercel → Environment Variables):
#   VITE_API_URL=https://deresegn-et.onrender.com/api
#   VITE_AUTH_URL=https://deresegn-et.onrender.com/api/auth
#
# On Render, set:
#   CLIENT_URL=https://tamagncheck.online
#   BETTER_AUTH_URL=https://deresegn-et.onrender.com/api/auth
# (cross-origin cookies need SameSite=None — server derives this automatically)

# Optional — Sentry
# VITE_SENTRY_DSN=
