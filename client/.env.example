# Frontend API base URL (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:5000/api

# Better Auth — must point at your deployed API in production
# VITE_AUTH_URL=https://your-api-host.com/api/auth
VITE_AUTH_URL=http://localhost:5000/api/auth

# Vercel production (set in Vercel → Environment Variables):
# VITE_API_URL=https://deresegn-et.onrender.com/api
# VITE_AUTH_URL=https://deresegn-et.onrender.com/api/auth
#
# Open the app at https://check-deresegn-et.vercel.app — not the Render URL.
