# Local development — copy to client/.env
VITE_API_URL=http://localhost:8787/api
VITE_AUTH_URL=http://localhost:8787/api/auth

# Vercel production (required for session cookies):
# Use same-origin paths so the browser stores cookies on tamagncheck.online
# and vercel.json rewrites /api → Cloudflare Worker.
#
#   VITE_API_URL=/api
#   VITE_AUTH_URL=https://tamagncheck.online/api/auth
#
# Or leave both unset — the client defaults to same-origin /api in production.
#
# Do NOT set VITE_AUTH_URL to *.workers.dev while VITE_API_URL is /api
# (login cookie would be on workers.dev and /api calls would 401).

# Optional — Sentry
# VITE_SENTRY_DSN=
