# Local development — copy to client/.env
VITE_API_URL=http://localhost:5000/api
VITE_AUTH_URL=http://localhost:5000/api/auth

# Vercel production — add these in Vercel → Settings → Environment Variables:
# VITE_API_URL=https://deresegn-et.onrender.com/api
# VITE_AUTH_URL=https://deresegn-et.onrender.com/api/auth

# Optional — error monitoring (Sentry browser SDK). The ErrorBoundary forwards
# crashes to window.Sentry when present. Load the Sentry loader/snippet with
# this DSN to activate; otherwise it's a no-op.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
