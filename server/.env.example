# Copy to .env and set your values — never commit .env

# Server
NODE_ENV=development
PORT=5000

# Frontend URL (Vercel app) — required for CORS in production
CLIENT_URL=http://localhost:5173
# Production:
# CLIENT_URL=https://check-deresegn-et.vercel.app

# Database (PostgreSQL / Neon) — required
DATABASE_URL=postgresql://user:password@localhost:5432/deresegn

# Better Auth — MUST be Render URL (not Vercel) when frontend is on Vercel
BETTER_AUTH_SECRET=generate-a-long-random-secret-here
BETTER_AUTH_URL=http://localhost:5000/api/auth
# Production (Render) — REQUIRED:
# BETTER_AUTH_URL=https://deresegn-et.onrender.com/api/auth
# NOT https://check-deresegn-et.vercel.app/api/auth

# Google Gemini — required for receipt AI extraction
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary — required for screenshot storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=deresegn

# Seed users (local only — npm run seed:users)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-admin-password
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=your-client-password

# E2E tests (local only)
E2E_EMAIL=client@example.com
E2E_PASSWORD=your-client-password
