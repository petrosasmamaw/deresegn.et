# Copy to .env and set your values

# Server
NODE_ENV=development
PORT=5000

# Frontend URL — your Vercel app (NOT the Render API URL)
CLIENT_URL=https://check-deresegn-et.vercel.app

# Database (PostgreSQL / Neon) — required
DATABASE_URL=postgresql://user:password@localhost:5432/deresegn

# Better Auth — must point at THIS API server (Render), not Vercel
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000/api/auth
# Production example:
# BETTER_AUTH_URL=https://deresegn-et.onrender.com/api/auth

# Google Gemini — required for receipt AI extraction
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary — required for screenshot storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=deresegn

