# Copy to .env and set your values

# Server
NODE_ENV=development
PORT=5000

# Frontend URL (CORS + Better Auth trusted origin)
CLIENT_URL=http://localhost:5173
# Optional extra origins (comma-separated), e.g. preview deployments
# CLIENT_URLS=https://deresegn-et.vercel.app
# https://deresegn-et.vercel.app is always allowed by default

# Database (PostgreSQL / Neon) — required
DATABASE_URL=postgresql://user:password@localhost:5432/deresegn

# Better Auth — required
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000/api/auth

# Google Gemini — required for receipt AI extraction
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary — required for screenshot storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=deresegn

