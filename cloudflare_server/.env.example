# Cloudflare Workers env reference
# Local: use .dev.vars (Wrangler loads it automatically)
# Production: wrangler.toml [vars] + `wrangler secret put NAME`

# --- Required secrets ---
DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://YOUR_WORKER.workers.dev/api/auth
CLIENT_URL=https://tamagncheck.online
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth / email ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tamagn Check
PASSWORD_RESET_URL=https://tamagncheck.online/reset-password

# --- Banks / Petros ---
PETROS_VERIFIER_API_KEY=
PETROS_VERIFIER_BASE_URL=
PETROS_VERIFIER_TIMEOUT_MS=45000
TELEBIRR_PREFER_PETROS=true
TELEBIRR_SKIP_DIRECT=true
PETROS_VERIFIER_RETRIES=2

# --- Optional ---
CLOUDINARY_FOLDER=deresegn
NODE_ENV=production
