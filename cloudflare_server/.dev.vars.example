# Copy from server/.env (or use this template) → cloudflare_server/.dev.vars for local wrangler dev
# Required overrides for local Workers:
#   NODE_ENV=development
#   BETTER_AUTH_URL=http://localhost:8787/api/auth
#   CLIENT_URL=http://localhost:5173
