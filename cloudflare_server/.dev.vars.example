GEMINI_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
PASSWORD_RESET_URL=http://localhost:5173/reset-password
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PETROS_VERIFIER_API_KEY=
PETROS_VERIFIER_BASE_URL=https://verifyapi.leulzenebe.pro
